{
  "name": "House Cleaner Robot Layout",
  "description": "Foxglove layout for the house cleaner robot: 3D scene with lidar, live map, battery percentage, robot velocity and raw lidar messages. Import via https://app.foxglove.dev -> Open connection -> ws://localhost:8765 -> Import layout.",
  "version": 1,
  "panels": [
    {
      "id": "3d-panel",
      "type": "3D",
      "title": "3D Scene (lidar + costmaps + robot)",
      "config": {
        "cameraState": {
          "distance": 12,
          "perspective": true,
          "phi": 60,
          "targetOffset": [0, 0, 0],
          "thetaOffset": 45
        },
        "followTf": "base_footprint",
        "followMode": "follow-pose",
        "scene": {},
        "topics": {
          "/scan": { "visible": true, "pointSize": 3, "colorMode": "colormap", "colorMap": "turbo" },
          "/map": { "visible": true, "colorMode": "map", "alpha": 0.6 },
          "/global_costmap/costmap": { "visible": true, "colorMode": "costmap", "alpha": 0.5 },
          "/local_costmap/costmap": { "visible": true, "colorMode": "costmap", "alpha": 0.6 },
          "/plan": { "visible": true, "lineWidth": 0.03 },
          "/plan_smoothed": { "visible": true, "lineWidth": 0.03 },
          "/controller_server/optimal_path": { "visible": true, "lineWidth": 0.02 },
          "/controller_server/candidate_trajectories": { "visible": false }
        }
      }
    },
    {
      "id": "map-panel",
      "type": "map",
      "title": "Occupancy Map",
      "config": {
        "layer": "occupancy",
        "topicPath": "/map"
      }
    },
    {
      "id": "battery-plot",
      "type": "plot",
      "title": "Battery Percentage",
      "config": {
        "showXAxisLabels": true,
        "showYAxisLabels": true,
        "showLegend": true,
        "isSynced": true,
        "xAxisVal": "timestamp",
        "paths": [
          {
            "topic": "/battery_state",
            "value": "percentage",
            "label": "Battery (0-1 fraction)",
            "enabled": true,
            "color": "#17b45f",
            "timestampMethod": "receiveTime"
          }
        ]
      }
    },
    {
      "id": "battery-gauge",
      "type": "rawMessages",
      "title": "Battery Raw (percentage / voltage / current)",
      "config": {
        "topicPath": "/battery_state"
      }
    },
    {
      "id": "velocity-plot",
      "type": "plot",
      "title": "Robot Velocity (commanded + smoothed)",
      "config": {
        "showXAxisLabels": true,
        "showYAxisLabels": true,
        "showLegend": true,
        "isSynced": true,
        "xAxisVal": "timestamp",
        "paths": [
          {
            "topic": "/cmd_vel_smoothed",
            "value": "linear.x",
            "label": "linear.x (m/s)",
            "enabled": true,
            "color": "#1f6fb2",
            "timestampMethod": "receiveTime"
          },
          {
            "topic": "/cmd_vel_smoothed",
            "value": "angular.z",
            "label": "angular.z (rad/s)",
            "enabled": true,
            "color": "#e07b1b",
            "timestampMethod": "receiveTime"
          },
          {
            "topic": "/cmd_vel",
            "value": "linear.x",
            "label": "linear.x post-collision-monitor",
            "enabled": true,
            "color": "#c0392b",
            "timestampMethod": "receiveTime"
          }
        ]
      }
    },
    {
      "id": "odom-velocity",
      "type": "rawMessages",
      "title": "Odometry (measured twist)",
      "config": {
        "topicPath": "/odom"
      }
    },
    {
      "id": "lidar-raw",
      "type": "rawMessages",
      "title": "Lidar Raw (/scan LaserScan)",
      "config": {
        "topicPath": "/scan"
      }
    },
    {
      "id": "lidar-plot",
      "type": "plot",
      "title": "Lidar Range Sectors (front / left / right)",
      "config": {
        "showXAxisLabels": true,
        "showYAxisLabels": true,
        "showLegend": true,
        "isSynced": true,
        "xAxisVal": "timestamp",
        "paths": [
          {
            "topic": "/scan",
            "value": "ranges[0]",
            "label": "ranges[0] (front, 0 deg)",
            "enabled": true,
            "color": "#6b4ca8",
            "timestampMethod": "receiveTime"
          },
          {
            "topic": "/scan",
            "value": "ranges[90]",
            "label": "ranges[90] (left, ~90 deg)",
            "enabled": true,
            "color": "#1f6fb2",
            "timestampMethod": "receiveTime"
          },
          {
            "topic": "/scan",
            "value": "ranges[270]",
            "label": "ranges[270] (right, ~270 deg)",
            "enabled": true,
            "color": "#c0392b",
            "timestampMethod": "receiveTime"
          },
          {
            "topic": "/scan",
            "value": "range_min",
            "label": "range_min",
            "enabled": false,
            "color": "#5a6472",
            "timestampMethod": "receiveTime"
          }
        ]
      }
    },
    {
      "id": "mission-state",
      "type": "rawMessages",
      "title": "Dock + Mission State",
      "config": {
        "topicPath": "/dock/state"
      }
    }
  ],
  "layout": {
    "type": "tab",
    "children": [
      {
        "type": "row",
        "children": [
          {
            "type": "column",
            "children": ["3d-panel", "battery-plot", "velocity-plot"],
            "weight": 0.55
          },
          {
            "type": "column",
            "children": ["map-panel", "lidar-plot", "battery-gauge", "lidar-raw", "odom-velocity"],
            "weight": 0.45
          }
        ]
      }
    ]
  }
}
