<?xml version="1.0" ?>
<!--
  single_room.world
  Simple complete world: one empty room, interior 4.65 x 5.75 m,
  matching the house_cleaner nav2 map geometry (origin -1.195,-2.385,
  spans x:[-1.195,3.455], y:[-2.385,3.365]).
  Plain materials — no textures, no fuel downloads.
-->
<sdf version="1.9">
  <world name="single_room">
    <gravity>0 0 -9.8</gravity>

    <physics name="default_physics" default="true" type="dart">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- System plugins — must be declared explicitly (like the house world);
         without them the sensors system never loads and IMU/lidar stay silent -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <scene>
      <ambient>0.5 0.5 0.5</ambient>
      <background>0.6 0.6 0.6</background>
      <shadows>0</shadows>
    </scene>

    <light name="sun" type="directional">
      <pose>0 0 3 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Floor: 5.05 x 6.15 m slab, top surface at z=0 -->
    <model name="floor">
      <static>true</static>
      <link name="floor_link">
        <collision name="floor_collision">
          <geometry>
            <box>
              <size>5.05 6.15 0.2</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="floor_visual">
          <geometry>
            <box>
              <size>5.05 6.15 0.2</size>
            </box>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
      <pose>0 0 -0.1 0 0 0</pose>
    </model>

    <!-- Walls: 0.2 m thick, 1.2 m high, interior 4.65 x 5.75 m -->
    <!-- North wall (y=+2.875) -->
    <model name="wall_north">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>4.85 0.2 1.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>4.85 0.2 1.2</size></box></geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>0 2.975 0.6 0 0 0</pose>
    </model>

    <!-- South wall (y=-2.875) -->
    <model name="wall_south">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>4.85 0.2 1.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>4.85 0.2 1.2</size></box></geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>0 -2.975 0.6 0 0 0</pose>
    </model>

    <!-- East wall (x=+2.325) -->
    <model name="wall_east">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 6.15 1.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 6.15 1.2</size></box></geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>2.425 0 0.6 0 0 0</pose>
    </model>

    <!-- West wall (x=-2.325) -->
    <model name="wall_west">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 6.15 1.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 6.15 1.2</size></box></geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>-2.425 0 0.6 0 0 0</pose>
    </model>

  </world>
</sdf>
