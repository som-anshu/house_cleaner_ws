<?xml version="1.0" ?>
<!--
  house_room.world
  Autonomous-cleaning demo world: one room, interior 4.65 x 5.75 m
  (same geometry as the saved nav map), with
  furniture obstacles for flavor and a charging dock on the north wall.

  Obstacle layout keeps >= 0.5 m corridors for the burger (radius ~0.105 m)
  and leaves the dock approach corridor (x in [-0.4, 0.4], y in [1.3, 2.75])
  completely clear.

  Charging dock: center (0.0, 2.75), south face at y = 2.625, robot docks at
  (0.0, ~2.5) facing +y (yaw pi/2). House_cleaner_assistant knows this pose.
-->
<sdf version="1.9">
  <world name="house_room">
    <gravity>0 0 -9.8</gravity>

    <physics name="default_physics" default="true" type="dart">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- System plugins — must be declared explicitly (like the house world);
         without them the sensors system never loads and IMU/lidar stay silent -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <scene>
      <ambient>0.5 0.5 0.5</ambient>
      <background>0.6 0.6 0.6</background>
      <shadows>0</shadows>
    </scene>

    <light name="sun" type="directional">
      <pose>0 0 3 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Floor: 5.05 x 6.15 m slab, top surface at z=0 -->
    <model name="floor">
      <static>true</static>
      <link name="floor_link">
        <collision name="floor_collision">
          <geometry>
            <box>
              <size>5.05 6.15 0.2</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="floor_visual">
          <geometry>
            <box>
              <size>5.05 6.15 0.2</size>
            </box>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
      <pose>0 0 -0.1 0 0 0</pose>
    </model>

    <!-- Walls: 0.2 m thick, 1.2 m high, interior 4.65 x 5.75 m -->
    <!-- North wall (y=+2.875) -->
    <model name="wall_north">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>4.85 0.2 1.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>4.85 0.2 1.2</size></box></geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>0 2.975 0.6 0 0 0</pose>
    </model>

    <!-- South wall (y=-2.875) -->
    <model name="wall_south">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>4.85 0.2 1.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>4.85 0.2 1.2</size></box></geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>0 -2.975 0.6 0 0 0</pose>
    </model>

    <!-- East wall (x=+2.325) -->
    <model name="wall_east">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 6.15 1.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 6.15 1.2</size></box></geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>2.425 0 0.6 0 0 0</pose>
    </model>

    <!-- West wall (x=-2.325) -->
    <model name="wall_west">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 6.15 1.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 6.15 1.2</size></box></geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>-2.425 0 0.6 0 0 0</pose>
    </model>

    <!-- ============ Furniture obstacles (flavor) ============ -->

    <!-- Sofa: 1.6 x 0.7 x 0.6, east-center -->
    <model name="sofa">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.6 0.7 0.6</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.6 0.7 0.6</size></box></geometry>
          <material>
            <ambient>0.45 0.2 0.15 1</ambient>
            <diffuse>0.55 0.25 0.18 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>1.05 0.55 0.3 0 0 0</pose>
    </model>

    <!-- Coffee table: 0.9 x 0.6 x 0.45, west-center -->
    <model name="coffee_table">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.9 0.6 0.45</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.9 0.6 0.45</size></box></geometry>
          <material>
            <ambient>0.4 0.28 0.15 1</ambient>
            <diffuse>0.5 0.35 0.2 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>-0.75 -0.45 0.225 0 0 0</pose>
    </model>

    <!-- Potted plant: cylinder r=0.18, h=0.9, NW corner -->
    <model name="plant">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.18</radius><length>0.9</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.18</radius><length>0.9</length></cylinder></geometry>
          <material>
            <ambient>0.1 0.45 0.15 1</ambient>
            <diffuse>0.15 0.55 0.2 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>-1.6 1.65 0.45 0 0 0</pose>
    </model>

    <!-- Crate A: 0.45 cube, SE area -->
    <model name="crate_a">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.45 0.45 0.45</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.45 0.45 0.45</size></box></geometry>
          <material>
            <ambient>0.55 0.45 0.3 1</ambient>
            <diffuse>0.65 0.55 0.35 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>1.65 -1.7 0.225 0 0 0</pose>
    </model>

    <!-- Crate B: 0.45 cube, SW area -->
    <model name="crate_b">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.45 0.45 0.45</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.45 0.45 0.45</size></box></geometry>
          <material>
            <ambient>0.55 0.45 0.3 1</ambient>
            <diffuse>0.65 0.55 0.35 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>-1.35 -2.0 0.225 0 0 0</pose>
    </model>

    <!-- ============ Charging dock (north wall) ============ -->
    <!-- Body box 1.0 x 0.25 x 0.35, sitting ON the floor (z=0):
         - lidar plane at z=0.172 hits the south face -> laser-detectable
         - body flush with the floor -> robot cannot pass underneath
         - 1.0 m wide face absorbs Nav2's 0.25 m arrival tolerance
         South face at y = 2.625. Emissive strip is the contact plate. -->
    <model name="charging_dock">
      <static>true</static>
      <link name="dock_link">
        <collision name="dock_collision">
          <geometry><box><size>1.0 0.25 0.35</size></box></geometry>
        </collision>
        <visual name="dock_visual">
          <geometry><box><size>1.0 0.25 0.35</size></box></geometry>
          <material>
            <ambient>0.15 0.15 0.55 1</ambient>
            <diffuse>0.2 0.2 0.75 1</diffuse>
          </material>
        </visual>
        <visual name="strip_visual">
          <pose>0 -0.13 0.1 0 0 0</pose>
          <geometry><box><size>0.9 0.02 0.12</size></box></geometry>
          <material>
            <ambient>1 0.8 0.1 1</ambient>
            <diffuse>1 0.85 0.1 1</diffuse>
            <emissive>1 0.8 0.1 1</emissive>
          </material>
        </visual>
      </link>
      <pose>0 2.75 0.0 0 0 0</pose>
    </model>

  </world>
</sdf>
