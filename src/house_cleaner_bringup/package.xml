<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema-instance" schemalocation="http://download.ros.org/schema/package_format3.xsd"?>
<package format="3">
  <name>house_cleaner_bringup</name>
  <version>0.3.0</version>
  <description>
    Launch files, config, worlds and models for the house cleaner robot.
    This package has NO runtime nodes of its own — it wires together the
    split packages (mission, battery, docking, msgs, core) with Gazebo /
    Nav2 / SLAM / Foxglove for both simulation and real-hardware bringup.
  </description>
  <maintainer email="koko@example.com">koko</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>house_cleaner_msgs</exec_depend>
  <exec_depend>house_cleaner_core</exec_depend>
  <exec_depend>house_cleaner_battery</exec_depend>
  <exec_depend>house_cleaner_docking</exec_depend>
  <exec_depend>house_cleaner_mission</exec_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>

  <!-- Simulation -->
  <exec_depend>turtlebot3_description</exec_depend>
  <exec_depend>turtlebot3_gazebo</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>

  <!-- SLAM / Nav2 -->
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>nav2_controller</exec_depend>
  <exec_depend>nav2_planner</exec_depend>
  <exec_depend>nav2_behaviors</exec_depend>
  <exec_depend>nav2_bt_navigator</exec_depend>
  <exec_depend>nav2_waypoint_follower</exec_depend>
  <exec_depend>nav2_velocity_smoother</exec_depend>
  <exec_depend>nav2_smoother</exec_depend>
  <exec_depend>nav2_collision_monitor</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>nav2_amcl</exec_depend>

  <!-- Visualization / teleop -->
  <exec_depend>rviz2</exec_depend>
  <exec_depend>foxglove_bridge</exec_depend>
  <exec_depend>teleop_twist_keyboard</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>